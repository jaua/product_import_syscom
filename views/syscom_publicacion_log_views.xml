<odoo>
    <record id="view_syscom_publicacion_log_list" model="ir.ui.view">
        <field name="name">syscom.publicacion.log.list</field>
        <field name="model">syscom.publicacion.log</field>
        <field name="arch" type="xml">
            <list string="Bitácora de Publicaciones" create="false" edit="false">
                <field name="fecha"/>
                <field name="default_code"/>
                <field name="product_tmpl_id"/>
                <field name="evento"/>
                <field name="motivo"/>
                <field name="detalle"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario de bitácora de publicaciones -->
    <record id="view_syscom_publicacion_log_form" model="ir.ui.view">
        <field name="name">syscom.publicacion.log.form</field>
        <field name="model">syscom.publicacion.log</field>
        <field name="arch" type="xml">
            <form string="Detalle de Publicación/Despublicación" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="fecha"/>
                            <field name="default_code"/>
                            <field name="product_tmpl_id"/>
                        </group>
                        <group>
                            <field name="evento"/>
                            <field name="motivo"/>
                            <field name="detalle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción para bitácora de publicaciones -->
    <record id="action_syscom_publicacion_log" model="ir.actions.act_window">
        <field name="name">Bitácora de Publicaciones</field>
        <field name="res_model">syscom.publicacion.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No hay registros de publicaciones/despublicaciones
            </p>
            <p>
                Aquí se registra cada despublicación automática que hace este módulo
                (por existencia 0 o por ausencia confirmada del CSV). La publicación
                de un producto sigue siendo siempre una decisión manual, por lo que
                este módulo no genera eventos de "publicado". Los registros se
                conservan según "Días de retención" en la configuración de Syscom.
            </p>
        </field>
    </record>
</odoo>
