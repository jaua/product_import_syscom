<odoo>
    <!-- Vista de formulario de configuración -->
    <record id="view_syscom_config_form" model="ir.ui.view">
        <field name="name">syscom.config.form</field>
        <field name="model">syscom.config</field>
        <field name="arch" type="xml">
            <form string="Configuración Syscom">
                <header>
                    <!-- Restringido a administradores: syscom.log/product.provider.syscom
                         solo son escribibles/legibles por base.group_system; un usuario
                         normal que use este botón recibiría un AccessError. -->
                    <button name="ejecutar_importacion"
                            string="Ejecutar Importación"
                            type="object"
                            class="oe_highlight"
                            icon="fa-play"
                            groups="base.group_system"/>
                    <button name="homologar_categorias"
                            string="Homologar Categorías"
                            type="object"
                            icon="fa-sitemap"
                            groups="base.group_system"
                            confirm="Esto migrará las categorías de TODOS los productos a la jerarquía Todos/All y eliminará las categorías obsoletas. ¿Continuar?"/>
                    <!-- MEJORA-75: da por revisadas las categorías nuevas del último CSV -->
                    <button name="action_marcar_categorias_revisadas"
                            string="Marcar categorías como revisadas"
                            type="object"
                            icon="fa-check"
                            groups="base.group_system"
                            invisible="not alerta_categorias"/>
                </header>
                <sheet>
                    <!-- MEJORA-75: filtros sin coincidencia / categorías nuevas del CSV -->
                    <div class="alert alert-warning" role="alert" invisible="not alerta_categorias">
                        <strong>Revise el filtro de categorías:</strong>
                        <field name="alerta_categorias" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <group string="Configuración de Descarga">
                            <field name="syscom_url_csv" placeholder="https://ejemplo.syscom.mx/productos.csv"/>
                            <field name="periodo_segundos" widget="integer"/>
                            <field name="hora_ejecucion" widget="float_time"/>
                        </group>
                        <group string="Configuración de Importación">
                            <field name="categorias_importar"
                                   placeholder='"Computadoras", "Laptops", "Accesorios"'
                                   widget="text"/>
                            <field name="ganancia_porcentaje"/>
                            <field name="usd_a_mxn"/>
                            <!-- MEJORA-46: tasa_cambio visible solo cuando se activa conversión USD→MXN -->
                            <field name="tasa_cambio"
                                   invisible="not usd_a_mxn"/>
                            <field name="dias_ausencia_maxima"/>
                            <field name="dias_retencion_bitacora_publicaciones"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Información">
                            <group>
                                <field name="version_modulo" readonly="1"/>
                                <p>
                                    <strong>Instrucciones de uso:</strong>
                                    <ul>
                                        <li>Configure la URL del archivo CSV de Syscom</li>
                                        <li>Defina el periodo entre descargas automáticas (en segundos)</li>
                                        <li>Establezca la hora de ejecución automática diaria</li>
                                        <li>Opcionalmente, filtre las categorías a importar</li>
                                        <li>Configure el porcentaje de ganancia para calcular precios de venta</li>
                                        <li>Use el botón "Ejecutar Importación" para una ejecución manual</li>
                                        <li>La descripción eCommerce de los productos publicados se actualiza
                                            automáticamente al final de cada importación, siempre que el archivo
                                            de token Bearer de Syscom esté montado (ver /mnt/DATA/token.dat)</li>
                                        <li>Los productos publicados que lleven más de "Días máximos de ausencia"
                                            sin aparecer en el CSV se despublican automáticamente (tras confirmarlo
                                            contra la API de Syscom); si hay filtro de categorías, solo aplica a
                                            productos dentro de esas categorías</li>
                                        <li>Cada despublicación automática queda registrada en la "Bitácora de
                                            Publicaciones"; "Días de retención" define cuánto se conservan esos
                                            registros (0 o negativo = indefinido)</li>
                                    </ul>
                                </p>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de lista de configuración -->
    <record id="view_syscom_config_list" model="ir.ui.view">
        <field name="name">syscom.config.list</field>
        <field name="model">syscom.config</field>
        <field name="arch" type="xml">
            <list string="Configuraciones Syscom">
                <field name="syscom_url_csv"/>
                <field name="periodo_segundos"/>
                <field name="hora_ejecucion" widget="float_time"/>
                <field name="ganancia_porcentaje"/>
            </list>
        </field>
    </record>

    <!-- Acción para configuración -->
    <record id="action_syscom_config" model="ir.actions.act_window">
        <field name="name">Configuración Syscom</field>
        <field name="res_model">syscom.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configurar importación de productos Syscom
            </p>
            <p>
                Configure los parámetros para la importación automática de productos desde Syscom.
            </p>
        </field>
    </record>
</odoo>